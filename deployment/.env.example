# ============================================================================
# Orca — example environment file
# Copy to .env (cp .env.example .env) and fill in the values below.
# Never commit .env. Keep .env.example free of real secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# LLM provider (free, no credit card) -- default
# Sign up: https://openrouter.ai  ->  Keys -> Create Key
# Free models: https://openrouter.ai/collections/free-models
# ----------------------------------------------------------------------------
OPENROUTER_API_KEY=

# ----------------------------------------------------------------------------
# Reranker (free trial, no credit card)
# Sign up: https://dashboard.cohere.com  -> API Keys (auto-generated trial key)
# 1,000 calls/month, resets monthly.
# ----------------------------------------------------------------------------
COHERE_API_KEY=

# ----------------------------------------------------------------------------
# Vector DB (local Docker -- no key needed)
# Override only if you use Qdrant Cloud.
# ----------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ----------------------------------------------------------------------------
# Course corpus on Hugging Face (only needed for PRIVATE datasets)
# Public datasets download anonymously. Get a token at
# https://huggingface.co/settings/tokens  (read scope is enough).
# ----------------------------------------------------------------------------
HF_TOKEN=
HF_DATASET_REPO=Altgan/rag-for-unstructured-data

# ----------------------------------------------------------------------------
# Optional LLM providers -- only needed if you change LLM_MODEL_TYPE in
# core/retrieval_api/config/config.yaml. Both require funded accounts in 2026.
# ----------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Redis (Celery broker for the ingest worker -- local Docker, no key)
# ----------------------------------------------------------------------------
INGEST_REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------------------
# Ingest LLM keys (multi-provider JSON map -- only the active LLM_PROVIDER is read)
# Example:
# INGEST_LLM_API_KEYS={"openrouter":"sk-or-v1-..."}
# ----------------------------------------------------------------------------
INGEST_LLM_API_KEYS={"openrouter":""}

# ----------------------------------------------------------------------------
# Prometheus / Grafana monitoring (optional, used by docker-compose)
# ----------------------------------------------------------------------------
PROMETHEUS_SCRAPE_INTERVAL=15s
QDRANT_TARGET=qdrant:6333
PROMETHEUS_TARGET=localhost:9090

# ----------------------------------------------------------------------------
# Optional LLM providers -- only needed if you change LLM_MODEL_TYPE in
# core/retrieval_api/config/config.yaml. Both require funded accounts in 2026.
# ----------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Optional AWS / CloudWatch -- only if you deploy Orca to AWS.
# Leave blank for local-only runs.
# ----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET_NAME=
